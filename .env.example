# API Keys for TripVerse External Services
# Copy this file to .env and fill in your keys

# Groq AI API Key (for AI chat and travel planning)
# Get from: https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API Key (for enriched web search)
# Get from: https://tavily.com/
VITE_TAVILY_API_KEY=your_tavily_api_key_here

# ExchangeRate API Key (for currency conversion)
# Get from: https://www.exchangerate-api.com/
VITE_EXCHANGERATE_API_KEY=your_exchangerate_api_key_here

# Public APIs (no keys required)
# Open-Meteo Weather: https://api.open-meteo.com/v1/forecast
# OpenStreetMap: https://api.openstreetmap.org/api/0.6/
# Leaflet Tiles: https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Overpass API: https://overpass-api.de/api/interpreter
# Wikipedia: https://en.wikipedia.org/api/rest_v1/

# Development Settings
VITE_API_BASE_URL=http://localhost:3000/api
